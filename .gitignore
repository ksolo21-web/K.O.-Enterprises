# Local configuration and secrets
.env
.env.*
!.env.example
credentials*.json
secrets.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/

# Runtime state and databases (the schema and migrations belong in source)
state/*
!state/.gitkeep
*.db
*.db-*
*.db.initialize.lock
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite.initialize.lock
*.sqlite3.initialize.lock

# Generated or sensitive operating material
reports/generated/
reports/private/
evidence/raw/
exports/
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
