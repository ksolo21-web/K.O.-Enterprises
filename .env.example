# Copy to .env for a shell or environment loader to use. Never commit the
# populated .env file. The stdlib CLI reads process environment variables but
# intentionally does not auto-load .env files.

# Start paused. The PAUSE_AUTONOMY marker is the primary fail-safe; this
# environment setting is a second, process-level stop signal.
COMPANY_OS_PAUSED=1

# Local-only runtime paths. SQLite data and generated reports are gitignored.
# Resolve the repository root explicitly when commands may run elsewhere.
COMPANY_OS_DB_PATH=state/company_os.db
COMPANY_OS_REPO_ROOT=.
COMPANY_OS_REPORT_DIR=reports/generated

# Human-readable identity written to new CLI-created audit records.
COMPANY_OS_ACTOR=local-operator
