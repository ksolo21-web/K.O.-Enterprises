{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/territory-project.schema.json",
  "title": "Territory Map Card Project",
  "type": "object",
  "required": ["navigation_presentation_review", "housing_instruction_review", "coverage_review", "current_inventory_review", "major_crossroad_review", "schema_version", "map_mode", "territory_id", "locality", "sources", "boundary", "roads", "labels", "sites", "entrances", "navigation_context", "source_transform", "preservation_audit", "directions", "corrections", "qa", "sidebar_qa", "output"],
  "$defs": {
    "auditExtent": {
      "type": "object",
      "required": [
        "crs",
        "bounds",
        "evidence"
      ],
      "properties": {
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "assignmentSegment": {
      "type": "object",
      "required": [
        "road_id",
        "source_feature_id",
        "from_ref",
        "to_ref",
        "classification",
        "work_rule",
        "inside_side",
        "verified",
        "assignment_evidence"
      ],
      "properties": {
        "road_id": {
          "type": "string",
          "minLength": 1
        },
        "source_feature_id": {
          "type": "string",
          "minLength": 1
        },
        "from_ref": {
          "type": "string",
          "minLength": 1
        },
        "to_ref": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "interior",
            "perimeter",
            "excluded"
          ]
        },
        "work_rule": {
          "enum": [
            "both_sides",
            "inside_only",
            "do_not_work"
          ]
        },
        "inside_side": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "const": true
        },
        "assignment_evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "inventorySource": {
      "type": "object",
      "required": [
        "id",
        "url",
        "retrieved_at",
        "source_recency",
        "query",
        "retrieval_evidence",
        "complete",
        "returned_count",
        "retrieved_feature_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "source_recency": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_evidence": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "const": true
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "retrieved_feature_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "inventoryFeature": {
      "type": "object",
      "required": [
        "source_id",
        "feature_id",
        "kind",
        "location",
        "disposition",
        "eligibility",
        "assignment_evidence",
        "evidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "road",
            "access",
            "property"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "matched",
            "verified_addition",
            "excluded"
          ]
        },
        "eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "not_applicable"
          ]
        },
        "assignment_evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_review": {
            "properties": {
              "representation": {
                "const": "explicit_road_segment_assignment"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "map_mode": {
            "const": "preserve_supplied_map"
          },
          "boundary": {
            "properties": {
              "closed": {
                "type": "null"
              },
              "no_self_intersections": {
                "type": "null"
              },
              "geometry_verified": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "boundary": {
            "properties": {
              "closed": {
                "const": true
              },
              "no_self_intersections": {
                "const": true
              },
              "geometry_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "neutral_knockout_review": {
      "type": "object",
      "required": ["plan", "authority", "operation_receipt", "source_after", "report", "independent_visual_review"],
      "description": "One native neutral fill; mandatory direct native/RGB custody replay plus independent source-plan and visual review."
    },
    "housing_instruction_review": {"type": "object", "required": ["rule_precedence", "user_decision", "assignment_source_ref", "assignment_source_sha256", "assigned_housing", "included_housing_types", "legacy_housing_exclusions", "legacy_instruction_evidence", "resolutions", "rendered_instructions_text", "unresolved_conflicts", "assignment_scope_preserved", "work_colors_preserved", "inside_only_sides_preserved", "map_exclusions_preserved", "instructions_review_completed", "evidence", "excluded_property_review"], "properties": {"assignment_source_ref": {"type": "string", "minLength": 1}, "legacy_instruction_evidence": {"type": "string", "minLength": 1}, "rendered_instructions_text": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "rule_precedence": {"const": "marked_assignment_over_legacy_housing_exclusions"}, "user_decision": {"type": "object", "required": ["date", "instruction", "source_ref"], "properties": {"date": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}}}, "assignment_source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "unresolved_conflicts": {"const": []}, "assignment_scope_preserved": {"const": true}, "work_colors_preserved": {"const": true}, "inside_only_sides_preserved": {"const": true}, "map_exclusions_preserved": {"const": true}, "instructions_review_completed": {"const": true}, "included_housing_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["single_family_homes", "apartments", "condominiums", "townhomes", "mobile_homes", "other_residential"]}}, "legacy_housing_exclusions": {"type": "array", "uniqueItems": true, "items": {"enum": ["single_family_homes", "apartments", "condominiums", "townhomes", "mobile_homes", "other_residential"]}}, "assigned_housing": {"type": "array", "items": {"type": "object", "required": ["housing_type", "feature_refs", "assignment_evidence"], "properties": {"housing_type": {"enum": ["single_family_homes", "apartments", "condominiums", "townhomes", "mobile_homes", "other_residential"]}, "feature_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "feature_id"], "properties": {"source_id": {"type": "string", "minLength": 1}, "feature_id": {"type": "string", "minLength": 1}}}}, "assignment_evidence": {"type": "string", "minLength": 1}}}}, "excluded_property_review": {"type": "array", "items": {"type": "object", "required": ["basis", "feature_refs", "evidence"], "properties": {"basis": {"enum": ["map_exclusion", "outside_assignment", "inside_only_other_side", "assigned_other_territory", "access_rule", "nonresidential"]}, "feature_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "feature_id"], "properties": {"source_id": {"type": "string", "minLength": 1}, "feature_id": {"type": "string", "minLength": 1}}}}, "evidence": {"type": "string", "minLength": 1}}}}, "resolutions": {"type": "array", "items": {"type": "object", "required": ["housing_type", "previous_instruction", "revised_instruction", "assignment_evidence", "decision_ref"], "properties": {"housing_type": {"enum": ["single_family_homes", "apartments", "condominiums", "townhomes", "mobile_homes", "other_residential"]}, "previous_instruction": {"type": "string", "minLength": 1}, "revised_instruction": {"type": "string", "minLength": 1}, "assignment_evidence": {"type": "string", "minLength": 1}, "decision_ref": {"type": "string", "minLength": 1}}}}}},
    "coverage_review": {
      "type": "object",
      "required": [
        "representation",
        "map_mode",
        "source_ref",
        "source_sha256",
        "geometry_verified",
        "full_coverage_resolved",
        "audit_extent",
        "edges_reviewed",
        "edge_evidence",
        "unresolved_edges"
      ],
      "properties": {
        "representation": {
          "enum": [
            "closed_polygon",
            "explicit_road_segment_assignment"
          ]
        },
        "map_mode": {
          "enum": [
            "preserve_supplied_map",
            "vector_rebuild"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "geometry_verified": {
          "const": true
        },
        "full_coverage_resolved": {
          "const": true
        },
        "audit_extent": {
          "$ref": "#/$defs/auditExtent"
        },
        "edges_reviewed": {
          "const": true
        },
        "edge_evidence": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_edges": {
          "type": "array",
          "maxItems": 0
        },
        "segment_assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assignmentSegment"
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "explicit_road_segment_assignment"
              }
            }
          },
          "then": {
            "required": [
              "segment_assignments"
            ],
            "properties": {
              "map_mode": {
                "const": "preserve_supplied_map"
              }
            }
          }
        }
      ]
    },
    "current_inventory_review": {
      "type": "object",
      "required": [
        "check_date",
        "full_boundary_and_edges_checked",
        "source_retrieval_complete",
        "relevant_property_eligibility_resolved",
        "unresolved_discrepancies",
        "unresolved_candidates",
        "evidence",
        "audit_extent",
        "sources",
        "feature_dispositions"
      ],
      "properties": {
        "check_date": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "full_boundary_and_edges_checked": {
          "const": true
        },
        "source_retrieval_complete": {
          "const": true
        },
        "relevant_property_eligibility_resolved": {
          "const": true
        },
        "unresolved_discrepancies": {
          "type": "array",
          "maxItems": 0
        },
        "unresolved_candidates": {
          "type": "array",
          "maxItems": 0
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "audit_extent": {
          "$ref": "#/$defs/auditExtent"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inventorySource"
          }
        },
        "feature_dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryFeature"
          }
        }
      },
      "additionalProperties": true
    },
    "schema_version": {"const": "2.2"},
    "map_mode": {"enum": ["preserve_supplied_map", "vector_rebuild"]},
    "territory_id": {"type": "string", "minLength": 1},
    "locality": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["organization", "dataset", "tier", "retrieved", "license_checked"],
        "properties": {
          "organization": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "tier": {"enum": ["user_supplied_map", "user_supplied_design_reference", "county_municipal", "state", "openstreetmap", "tiger_line", "live_map_name_verification", "legacy_reference"]},
          "retrieved": {"type": "string", "format": "date"},
          "license_checked": {"type": "boolean"},
          "url": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "boundary": {
      "type": "object",
      "required": ["source", "closed", "no_self_intersections", "geometry_verified"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "closed": {"type": ["boolean", "null"]},
        "no_self_intersections": {"type": ["boolean", "null"]},
        "geometry_verified": {"type": "boolean"},
        "georeferenced_from_legacy": {"type": "boolean"},
        "control_point_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "roads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "source_feature_id", "geometry_source", "classification", "work_rule", "inside_side", "geometry_verified", "visible", "label_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source_feature_id": {"type": "string", "minLength": 1},
          "geometry_source": {"type": "string", "minLength": 1},
          "classification": {"enum": ["interior", "perimeter", "excluded", "context"]},
          "work_rule": {"enum": ["both_sides", "inside_only", "do_not_work", "context_only"]},
          "inside_side": {"enum": ["left", "right", "north", "south", "east", "west", "mixed", "not_applicable"]},
          "geometry_verified": {"type": "boolean"},
          "visible": {"type": "boolean"},
          "label_status": {"enum": ["placed", "repeated", "not_required", "unresolved"]},
          "role": {"enum": ["standard", "major_context", "approach_context", "access_stem"]},
          "exception_reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "road_id", "text", "method", "direct_fit_available",
          "font_family", "font_weight", "guide_gap_min_px", "guide_gap_max_px",
          "guide_gap_spread_px", "covers_street", "overlaps_label", "clipped",
          "follows_street_shape"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "road_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "method": {"enum": ["direct", "curved", "callout", "repeated"]},
          "direct_fit_available": {"type": "boolean"},
          "font_family": {"type": "string", "minLength": 1},
          "font_weight": {"type": "integer"},
          "guide_gap_min_px": {"type": "number", "minimum": 0},
          "guide_gap_max_px": {"type": "number", "minimum": 0},
          "guide_gap_spread_px": {"type": "number", "minimum": 0},
          "covers_street": {"type": "boolean"},
          "overlaps_label": {"type": "boolean"},
          "clipped": {"type": "boolean"},
          "follows_street_shape": {"type": "boolean"},
          "arrow": {
            "type": ["object", "null"],
            "properties": {
              "target_road_id": {"type": "string", "minLength": 1},
              "target_kind": {"const": "street_stem"},
              "filled_triangular_head": {"type": "boolean"},
              "leader_length_px": {"type": "number", "minimum": 0},
              "start_gap_px": {"type": "number", "minimum": 0},
              "overlaps_label": {"type": "boolean"},
              "overlaps_arrow": {"type": "boolean"},
              "crosses_unrelated_road": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "verified", "source_ref", "verified_entrance_count", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["apartment_complex", "condominium_community", "mobile_home_park", "campus", "named_property", "other"]},
          "verified": {"type": "boolean"},
          "source_ref": {"type": "string", "minLength": 1},
          "verified_entrance_count": {"type": "integer", "minimum": 0},
          "label": {
            "type": "object",
            "required": ["text", "font_family", "font_weight", "centered_in_site_zone", "covers_route", "covers_building_or_work_shape", "overlaps_label", "clipped"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "font_family": {"type": "string", "minLength": 1},
              "font_weight": {"type": "integer"},
              "centered_in_site_zone": {"type": "boolean"},
              "covers_route": {"type": "boolean"},
              "covers_building_or_work_shape": {"type": "boolean"},
              "overlaps_label": {"type": "boolean"},
              "clipped": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "navigation_presentation_review": {"type": "object", "required": ["artifact_sha256", "actual_size_screenshot", "closeup_screenshots", "entrances", "street_paths", "label_placement"]},
    "entrances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "site_id",
          "verified",
          "source_ref",
          "public_road_id",
          "target_access_road_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "label_text": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "public_road_id": {
            "type": "string",
            "minLength": 1
          },
          "target_access_road_id": {
            "type": "string",
            "minLength": 1
          },
          "label_font_family": {
            "type": "string",
            "minLength": 1
          },
          "label_font_weight": {
            "type": "integer"
          },
          "label_overlaps_feature": {
            "type": "boolean"
          },
          "clipped": {
            "type": "boolean"
          },
          "target_box": {
            "type": "object",
            "required": [
              "x_min",
              "y_min",
              "x_max",
              "y_max"
            ],
            "properties": {
              "x_min": {
                "type": "number"
              },
              "y_min": {
                "type": "number"
              },
              "x_max": {
                "type": "number"
              },
              "y_max": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "arrow": {
            "type": "object",
            "required": [
              "target_access_road_id",
              "target_x",
              "target_y",
              "target_in_verified_box",
              "distance_to_access_px",
              "target_tolerance_px",
              "leader_length_px",
              "leader_min_px",
              "leader_max_px",
              "shaft_segment_count",
              "filled_triangular_head",
              "marker_bound",
              "overlaps_label",
              "overlaps_arrow",
              "crosses_unrelated_road",
              "route_overlap_outside_target_radius"
            ],
            "properties": {
              "target_access_road_id": {
                "type": "string",
                "minLength": 1
              },
              "target_x": {
                "type": "number"
              },
              "target_y": {
                "type": "number"
              },
              "target_in_verified_box": {
                "type": "boolean"
              },
              "distance_to_access_px": {
                "type": "number",
                "minimum": 0
              },
              "target_tolerance_px": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "leader_length_px": {
                "type": "number",
                "minimum": 0
              },
              "leader_min_px": {
                "type": "number",
                "minimum": 0
              },
              "leader_max_px": {
                "type": "number",
                "minimum": 0
              },
              "shaft_segment_count": {
                "type": "integer",
                "minimum": 1
              },
              "filled_triangular_head": {
                "type": "boolean"
              },
              "marker_bound": {
                "type": "boolean"
              },
              "overlaps_label": {
                "type": "boolean"
              },
              "overlaps_arrow": {
                "type": "boolean"
              },
              "crosses_unrelated_road": {
                "type": "boolean"
              },
              "route_overlap_outside_target_radius": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "representation": {
            "enum": [
              "named_street",
              "feature_callout",
              "numbered_key",
              "descriptive_access"
            ]
          }
        },
        "additionalProperties": true,
        "allOf": [
          {"if":{"required":["representation"],"properties":{"representation":{"const":"descriptive_access"}}},"then":{"required":["visible","descriptive_access_contract"],"properties":{"visible":{"const":true},"descriptive_access_contract":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}}}},
          {
            "if": {
              "required": [
                "representation"
              ],
              "properties": {
                "representation": {
                  "enum": ["named_street", "descriptive_access"]
                }
              }
            },
            "then": {},
            "else": {
              "required": [
                "id",
                "site_id",
                "label_text",
                "verified",
                "source_ref",
                "public_road_id",
                "target_access_road_id",
                "label_font_family",
                "label_font_weight",
                "label_overlaps_feature",
                "clipped",
                "target_box",
                "arrow"
              ]
            }
          }
        ]
      }
    },
    "major_crossroad_review": {
      "type": "object",
      "required": [
        "actual_size_review_completed",
        "closeup_review_completed",
        "distinct_physical_roads_verified",
        "directions_reference_both",
        "directions_text",
        "roads"
      ],
      "properties": {
        "actual_size_review_completed": {
          "const": true
        },
        "closeup_review_completed": {
          "const": true
        },
        "distinct_physical_roads_verified": {
